{
  "name": "neural-cryptography-experiments",
  "version": "0.1.0",
  "private": true,
  "description": "Neural cryptography and optical transport research experiments",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:apps": "node scripts/prepare-apps.mjs",
    "prepare:corrector": "node scripts/prepare-corrector.mjs",
    "test:corrector": "node --test apps/color-optical-bench/tests/learned-*.test.mjs apps/color-optical-bench/tests/corrector-lab*.test.mjs apps/color-optical-bench/tests/dataset.test.mjs apps/color-optical-bench/tests/capture-*.test.mjs apps/color-optical-bench/tests/neural-qr-acquisition.test.mjs apps/color-optical-bench/tests/collection-session-stack.test.mjs",
    "test:corrector:python": "python3 -m unittest discover -s experiments/neural-corrector/tests -v",
    "test:corrector:wasm": "node experiments/neural-corrector/browser-runtime/test-wasm.mjs",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test": "npm run test:color && npm run test:qr",
    "test:color": "npm --prefix apps/color-optical-bench test",
    "test:qr": "npm --prefix apps/qr-neural-key test",
    "test:parity": "npm --prefix apps/color-optical-bench run test:parity",
    "benchmark:crypto": "npm --prefix apps/color-optical-bench run benchmark:crypto",
    "benchmark:qr": "npm --prefix apps/qr-neural-key run benchmark:speed",
    "test:neural-zkboo": "npm --prefix apps/color-optical-bench run test:auth"
  },
  "license": "Apache-2.0",
  "author": "Alejandro Hernandez Ruiz (magnux)"
}
